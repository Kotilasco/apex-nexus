# ============================================================
# Apex Nexus — Environment Configuration
# Copy this file to .env and configure for your environment
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=apex_nexus
POSTGRES_USER=apex_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- MinIO (S3-Compatible Object Storage) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=apex_minio_admin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=apex-documents

# --- Elasticsearch ---
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# --- JWT Security ---
JWT_SECRET=CHANGE_ME_256_BIT_SECRET_KEY_FOR_JWT_SIGNING
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# --- Encryption (AES-256 for at-rest encryption) ---
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_AES_256_KEY_HERE
ENCRYPTION_ALGORITHM=AES/GCM/NoPadding

# --- Service Discovery ---
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
DOCUMENT_SERVICE_PORT=8082
WORKFLOW_SERVICE_PORT=8083
SEARCH_SERVICE_PORT=8084
RETENTION_SERVICE_PORT=8085
AUDIT_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087

# --- Email (SMTP for notifications) ---
SMTP_HOST=smtp.your-company.com
SMTP_PORT=587
SMTP_USERNAME=apex-notifications@your-company.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# --- Environment ---
SPRING_PROFILES_ACTIVE=dev
NODE_ENV=development
